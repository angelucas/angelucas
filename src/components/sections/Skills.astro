---
import Section from '../Section.astro';
import Badge from '../Badge.astro';
import { skills, type SkillCategory } from '@/data/skills';
import { useTranslations, type Lang } from '@/i18n/ui';
import { Server, Layout, Database, Cloud, Sparkles, Layers } from '@lucide/astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const categories: SkillCategory[] = ['backend', 'frontend', 'data', 'cloud', 'ai', 'practices'];

const categoryLabels: Record<SkillCategory, string> = {
  backend: t('skills.backend'),
  frontend: t('skills.frontend'),
  data: t('skills.data'),
  cloud: t('skills.cloud'),
  ai: t('skills.ai'),
  practices: t('skills.practices'),
};

const categoryIcons = {
  backend: Server,
  frontend: Layout,
  data: Database,
  cloud: Cloud,
  ai: Sparkles,
  practices: Layers,
} as const;
---

<Section id="skills" class="skills-section">
  <h2 class="section-title">{t('skills.title')}</h2>
  <p class="section-subtitle">{t('skills.subtitle')}</p>

  <div class="skills-grid">
    {
      categories.map((cat, index) => {
        const Icon = categoryIcons[cat];
        const items = skills.filter((s) => s.category === cat);
        return (
          <article class="skill-card card reveal" style={`--stagger-index: ${index}`}>
            <div class="skill-accent" aria-hidden="true" />
            <header class="skill-card-header">
              <span class="skill-icon-wrap" aria-hidden="true">
                <Icon class="skill-icon" size={20} stroke-width={1.5} />
              </span>
              <h3 class="skill-card-title">{categoryLabels[cat]}</h3>
              <span class="skill-count">{items.length}</span>
            </header>
            <ul class="skill-list">
              {items.map((skill) => (
                <li>
                  <Badge label={skill.name} />
                </li>
              ))}
            </ul>
          </article>
        );
      })
    }
  </div>
</Section>

<style>
  :global(.skills-section .section-title),
  :global(.skills-section .section-subtitle) {
    margin-bottom: 0;
  }

  :global(.skills-section .section-subtitle) {
    margin-bottom: 0.5rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .skill-card {
    position: relative;
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .skill-accent {
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--color-gradient-1),
      var(--color-gradient-2)
    );
    opacity: 0.85;
  }

  .skill-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 1.25rem 0;
  }

  .skill-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: var(--radius);
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    color: var(--color-accent-light);
    transition: var(--transition);
  }

  .skill-card:hover .skill-icon-wrap {
    border-color: rgba(59, 130, 246, 0.35);
    box-shadow: 0 0 16px rgba(59, 130, 246, 0.12);
  }

  .skill-icon {
    display: block;
  }

  .skill-card-title {
    flex: 1;
    font-size: 0.8125rem;
    font-weight: 600;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent-light);
    line-height: 1.3;
  }

  .skill-count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-muted);
    letter-spacing: 0.08em;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 1rem 1.25rem 1.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-icon-wrap {
      transition: none;
    }

    .skill-card:hover .skill-icon-wrap {
      box-shadow: none;
    }
  }
</style>
