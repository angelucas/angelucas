---
import Section from '../Section.astro';
import { experience } from '@/data/experience';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="experience">
  <h2 class="section-title">{t('experience.title')}</h2>
  <p class="section-subtitle">{t('experience.subtitle')}</p>

  <ol class="timeline">
    {
      experience.map((item, index) => (
        <li
          class:list={['timeline-item', 'reveal', index === 0 && 'timeline-item-current']}
          style={`--stagger-index: ${index}`}
        >
          <div class="timeline-rail" aria-hidden="true">
            <span class="timeline-marker">
              <span class="timeline-marker-ring" />
              <span class="timeline-marker-core" />
            </span>
          </div>
          <article class="timeline-content card">
            <header class="timeline-header">
              <h3 class="timeline-role">{item.role[lang]}</h3>
              <p class="timeline-company">{item.company}</p>
              <time class="timeline-period">{item.period[lang]}</time>
            </header>
            <ul class="timeline-highlights">
              {item.highlights[lang].map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .timeline {
    --timeline-track: 1.375rem;
    --timeline-gap: 1.25rem;
    --card-pad: 1.5rem;
    --role-line: 1.35rem;
    position: relative;
    list-style: none;
    padding-left: 0;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: calc(var(--timeline-track) / 2 - 1px);
    top: calc(var(--card-pad) + var(--role-line) / 2);
    bottom: calc(var(--card-pad) + var(--role-line) / 2);
    width: 2px;
    border-radius: 1px;
    background: linear-gradient(
      to bottom,
      var(--color-accent),
      var(--color-gradient-2),
      rgba(139, 92, 246, 0.25),
      transparent
    );
  }

  .timeline-item {
    display: grid;
    grid-template-columns: var(--timeline-track) minmax(0, 1fr);
    column-gap: var(--timeline-gap);
    align-items: start;
    padding-bottom: 2rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-rail {
    display: flex;
    justify-content: center;
    padding-top: calc(var(--card-pad) + (var(--role-line) - 1.375rem) / 2);
  }

  .timeline-marker {
    position: relative;
    flex-shrink: 0;
    width: 1.375rem;
    height: 1.375rem;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .timeline-marker-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(59, 130, 246, 0.45);
    background: var(--color-bg);
    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .timeline-marker-core {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 10px var(--color-accent-glow);
    transition:
      transform var(--transition),
      background var(--transition),
      box-shadow var(--transition);
  }

  .timeline-item-current .timeline-marker-ring {
    border-color: var(--color-accent-light);
    box-shadow: 0 0 18px rgba(59, 130, 246, 0.35);
  }

  .timeline-item-current .timeline-marker-core {
    width: 0.5625rem;
    height: 0.5625rem;
    background: var(--color-accent-light);
    box-shadow: 0 0 14px var(--color-accent-glow);
    animation: markerPulse 2.5s ease-in-out infinite;
  }

  .timeline-item:hover .timeline-marker-ring {
    border-color: var(--color-accent-light);
    transform: scale(1.08);
  }

  .timeline-item:hover .timeline-marker-core {
    transform: scale(1.15);
    box-shadow: 0 0 16px var(--color-accent-glow);
  }

  .timeline-content {
    transition: border-color var(--transition);
  }

  .timeline-item:hover .timeline-content {
    border-color: rgba(59, 130, 246, 0.28);
  }

  @keyframes markerPulse {
    0%,
    100% {
      box-shadow: 0 0 10px var(--color-accent-glow);
    }
    50% {
      box-shadow:
        0 0 10px var(--color-accent-glow),
        0 0 0 5px rgba(59, 130, 246, 0.12);
    }
  }

  .timeline-role {
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .timeline-company {
    color: var(--color-accent-light);
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .timeline-period {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .timeline-highlights {
    list-style: disc;
    padding-left: 1.25rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .timeline-highlights li {
    margin-bottom: 0.375rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-marker-ring,
    .timeline-marker-core,
    .timeline-content {
      transition: none;
    }

    .timeline-item-current .timeline-marker-core {
      animation: none;
    }

    .timeline-item:hover .timeline-marker-ring,
    .timeline-item:hover .timeline-marker-core {
      transform: none;
    }
  }
</style>
