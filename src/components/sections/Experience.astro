---
import Section from '../Section.astro';
import { experience } from '@/data/experience';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="experience">
  <h2 class="section-title">{t('experience.title')}</h2>
  <p class="section-subtitle">{t('experience.subtitle')}</p>

  <ol class="timeline">
    {
      experience.map((item, index) => (
        <li class="timeline-item reveal" style={`--stagger-index: ${index}`}>
          <span class="timeline-marker" aria-hidden="true" />
          <article class="timeline-content card">
            <header class="timeline-header">
              <h3 class="timeline-role">{item.role[lang]}</h3>
              <p class="timeline-company">{item.company}</p>
              <time class="timeline-period">{item.period[lang]}</time>
            </header>
            <ul class="timeline-highlights">
              {item.highlights[lang].map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .timeline {
    position: relative;
    list-style: none;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0.375rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--color-accent),
      var(--color-gradient-2),
      transparent
    );
  }

  .timeline-item {
    position: relative;
    padding-bottom: 2rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: -2rem;
    top: 1.25rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent-glow);
    transform: translateX(-5px);
  }

  .timeline-role {
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .timeline-company {
    color: var(--color-accent-light);
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .timeline-period {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .timeline-highlights {
    list-style: disc;
    padding-left: 1.25rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .timeline-highlights li {
    margin-bottom: 0.375rem;
  }
</style>
