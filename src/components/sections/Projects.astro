---
import Section from '../Section.astro';
import Badge from '../Badge.astro';
import { projects } from '@/data/projects';
import { useTranslations, type Lang } from '@/i18n/ui';
import { Gamepad2, Globe, Server, Code2, ArrowUpRight } from '@lucide/astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projectIcons = {
  sn50: Gamepad2,
  portfolio: Globe,
  apis: Server,
} as const;
---

<Section id="projects">
  <h2 class="section-title">{t('projects.title')}</h2>
  <p class="section-subtitle">{t('projects.subtitle')}</p>

  <ul class="projects-grid">
    {
      projects.map((project, index) => {
        const Icon = projectIcons[project.id as keyof typeof projectIcons] ?? Server;
        const hasLinks = Boolean(project.github || project.demo);

        return (
          <li class="projects-grid-item">
            <article class="project-card card">
              <div class="project-accent" aria-hidden="true" />

              <header class="project-header">
                <div class="project-icon-wrap">
                  <Icon class="project-icon" size={22} stroke-width={1.5} aria-hidden="true" />
                </div>
                <div class="project-heading">
                  <span class="project-index">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <h3 class="project-title">{project.title[lang]}</h3>
                </div>
              </header>

              <p class="project-desc">{project.description[lang]}</p>

              <ul class="project-stack">
                {project.stack.map((tech) => (
                  <li>
                    <Badge label={tech} />
                  </li>
                ))}
              </ul>

              {
                hasLinks && (
                  <footer class="project-footer">
                    {project.github && (
                      <a
                        href={project.github}
                        class="project-action btn btn-ghost"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <Code2 size={16} stroke-width={1.5} aria-hidden="true" />
                        {t('projects.viewCode')}
                      </a>
                    )}
                    {project.demo && (
                      <a
                        href={project.demo}
                        class="project-action btn btn-ghost"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <ArrowUpRight size={16} stroke-width={1.5} aria-hidden="true" />
                        {t('projects.viewDemo')}
                      </a>
                    )}
                  </footer>
                )
              }
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    list-style: none;
  }

  .projects-grid-item {
    display: flex;
  }

  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 100%;
    padding: 0;
    overflow: hidden;
  }

  .project-accent {
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--color-gradient-1),
      var(--color-gradient-2),
      var(--color-gradient-3)
    );
    opacity: 0.85;
    transition: opacity var(--transition);
  }

  .project-card:hover .project-accent {
    opacity: 1;
  }

  .project-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem 1.5rem 0;
  }

  .project-icon-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    color: var(--color-accent-light);
    transition: var(--transition);
  }

  .project-card:hover .project-icon-wrap {
    background: rgba(59, 130, 246, 0.16);
    border-color: rgba(59, 130, 246, 0.35);
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.15);
  }

  .project-icon {
    display: block;
  }

  .project-heading {
    flex: 1;
    min-width: 0;
  }

  .project-index {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--color-muted);
    margin-bottom: 0.35rem;
  }

  .project-title {
    font-size: 1.125rem;
    line-height: 1.35;
    word-break: break-word;
  }

  .project-desc {
    flex: 1;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    padding: 1rem 1.5rem 0;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .project-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: auto;
    margin-inline: 1.5rem;
    padding: 1.25rem 0 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .project-action {
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    gap: 0.5rem;
  }

  .project-action :global(svg) {
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-accent,
    .project-icon-wrap {
      transition: none;
    }

    .project-card:hover .project-icon-wrap {
      box-shadow: none;
    }
  }
</style>
